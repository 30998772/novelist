{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opencode-workflow-v1",
  "title": "Workflow Definition",
  "description": "opencode 工作流定义文件的 schema。定义节点顺序、输入输出、调度策略和文件输出路径。",
  "type": "object",
  "required": ["name", "nodes"],
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "工作流唯一标识，小写英文+连字符"
    },
    "description": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "input": {
      "type": "object",
      "description": "工作流的输入参数定义，key 为参数名",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["string", "number", "boolean", "array", "object"] },
          "required": { "type": "boolean", "default": false },
          "default": {},
          "description": { "type": "string" }
        },
        "required": ["type"]
      }
    },
    "output": {
      "type": "object",
      "description": "工作流的最终输出定义",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "output_config": {
      "$ref": "#/$defs/output_config"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/workflow_node"
      },
      "description": "节点列表，顺序由 depends_on 拓扑排序决定"
    },
    "schedule": {
      "$ref": "#/$defs/schedule_config"
    }
  },
  "$defs": {
    "workflow_node": {
      "type": "object",
      "required": ["id", "ref"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$",
          "description": "节点唯一 ID，蛇形命名"
        },
        "ref": {
          "type": "string",
          "description": "node JSON 文件的相对路径，如 nodes/research.json"
        },
        "inputs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "从 state 读取的字段名列表"
        },
        "outputs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "写入 state 的字段名列表"
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" },
          "description": "前置依赖节点 id 列表"
        }
      }
    },
    "output_config": {
      "type": "object",
      "properties": {
        "base_dir": {
          "type": "string",
          "description": "输出根目录，支持 {var} 模板替换（如 {project_dir}）"
        },
        "fallback_dir": {
          "type": "string",
          "description": "base_dir 未提供时的兜底目录"
        },
        "file_map": {
          "type": "object",
          "description": "每个节点的输出文件映射，key 为节点 id",
          "additionalProperties": {
            "$ref": "#/$defs/node_output_spec"
          }
        }
      }
    },
    "node_output_spec": {
      "type": "object",
      "properties": {
        "output_keys": {
          "type": "array",
          "items": { "type": "string" },
          "description": "要写入文件的 state 字段名列表"
        },
        "file": {
          "type": ["string", "null"],
          "description": "输出文件相对路径，支持 {var} 模板替换；null 表示不落盘"
        },
        "append": {
          "type": "boolean",
          "default": false,
          "description": "true 则追加到文件末尾"
        },
        "overwrite": {
          "type": "boolean",
          "default": false,
          "description": "true 则覆盖已有内容"
        },
        "format": {
          "type": "string",
          "enum": ["plain", "markdown", "markdown_table", "json"],
          "default": "plain",
          "description": "输出格式"
        },
        "description": { "type": "string" }
      }
    },
    "schedule_config": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["linear", "dag", "parallel"],
          "default": "linear",
          "description": "调度模式。linear=单节点顺序执行；dag/parallel=按就绪波次并发执行同一波次内互不依赖的节点，全部完成后 join 再进入下一波次"
        },
        "max_concurrency": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "并行调度时的最大并发度（0 表示等于当前就绪波次大小）。可被 auto 命令的 --workers 覆盖"
        },
        "max_iterations": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "description": "最大全局迭代次数"
        },
        "revise_loop": {
          "$ref": "#/$defs/revise_loop_config"
        },
        "interval": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "description": { "type": "string" }
          }
        }
      }
    },
    "revise_loop_config": {
      "type": "object",
      "description": "审稿→修改循环配置",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "trigger_node": {
          "type": "string",
          "description": "触发循环的节点 id（如 review）"
        },
        "loop_back_to": {
          "type": "string",
          "description": "循环回跳的目标节点 id（如 revise）"
        },
        "max_loops": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "description": "最大循环次数"
        },
        "exit_condition": {
          "type": "string",
          "description": "退出循环的条件描述（如 review_notes is empty）"
        }
      }
    }
  }
}
