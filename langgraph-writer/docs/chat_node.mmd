graph TB
    subgraph 简单循环["build_tool_loop"]
        A1["对话节点<br/>LLM+绑定工具"] --> B1{"工具判断"}
        B1 -- "有" --> C1["工具执行"]
        B1 -- "无" --> D1((结束))
        C1 --> A1
    end

    subgraph 推理循环["build_reason_loop"]
        A2["检查调用次数"] --> B2{"超限?"}
        B2 -- "是" --> G2["生成结论"]
        B2 -- "否" --> C2["LLM思考<br/>输出动作集合"]
        C2 --> D2["执行动作<br/>查询/提问"]
        D2 --> E2["分析观测<br/>更新发现"]
        E2 --> F2{"任务完成?"}
        F2 -- "是" --> G2
        F2 -- "否" --> A2
        G2 --> H2((结束))
    end
