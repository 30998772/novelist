graph TB
    开始((开始)) --> 历史管理["history_manager<br/>裁剪历史"]
    历史管理 --> 意图识别["intent_recognition<br/>LLM输出意图列表"]
    意图识别 --> 检查意图{"意图列表为空?"}
    
    检查意图 -- "是" --> 检查次数{"尝试次数>=3?"}
    检查意图 -- "否" --> 遍历["遍历意图列表"]
    
    检查次数 -- "是" --> 结束对话["end_conversation<br/>告知用户无法识别"]
    检查次数 -- "否" --> 追问["ask_clarification<br/>询问用户补充"]
    
    追问 --> 用户补充["用户补充内容"]
    用户补充 --> 历史管理
    
    遍历 --> 下一个{"还有下一个?"}
    下一个 -- "是" --> 路由{"意图路由"}
    下一个 -- "否" --> 收集["collect_results"]
    
    路由 --> 子图["执行子图"]
    子图 --> 保存["保存结果"]
    保存 --> 下一个
    
    收集 --> 对话["chatbot<br/>LLM整合结果<br/>一次性回答"]
    对话 --> 等待输入["等待用户输入"]
    等待输入 --> 检查输入{"用户输入了新内容?"}
    检查输入 -- "是" --> 历史管理
    检查输入 -- "否" --> 结束((结束))
