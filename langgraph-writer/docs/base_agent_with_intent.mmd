graph TB
    开始((开始)) --> 历史管理["history_manager<br/>裁剪历史/过滤Tool消息"]
    历史管理 --> 意图识别["intent_recognition<br/>LLM输出意图列表<br/>鲁棒解析JSON<br/>成功则重置追问计数"]
    意图识别 --> 检查意图{"route_after_intent<br/>意图列表为空?"}

    检查意图 -- "是" --> 追问["ask_clarification<br/>询问用户补充<br/>(追问计数+1)"]
    追问 --> 结束1((结束))
    结束1 -. "用户补充后重新进图" .-> 开始

    检查意图 -- "否" --> 分派["dispatch_next<br/>取intent_list下一个意图<br/>设为current_intent<br/>取完则清空"]
    分派 --> 路由{"route_dispatch<br/>current_intent为空?"}

    路由 -- "空(全部执行完)" --> 收集["collect_results<br/>汇总各意图产出为task<br/>注入history"]
    路由 -- "有意图" --> 子图["子图<br/>(按意图分派执行)"]
    子图 --> 分派

    收集 --> 对话["chatbot<br/>LLM整合结果回答<br/>(可绑定全部工具)"]
    对话 --> 工具判断{"tools_condition<br/>有tool_calls?"}
    工具判断 -- "是" --> 工具["tools<br/>ToolNode执行"]
    工具 --> 对话
    工具判断 -- "否" --> 结束2((结束))
